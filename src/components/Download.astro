<!-- Platforms -->
<div class="mt-20">
  <div class="text-center">
    <p class="text-sm font-medium uppercase tracking-[0.22em] text-purple-300">
      Platforms
    </p>

    <h3 class="mt-4 text-3xl font-semibold tracking-tight text-white">
      Built for your terminal.
    </h3>

    <p class="mx-auto mt-4 max-w-xl text-white/45">
      Prebuilt binaries are available for the platforms Luma supports.
    </p>
  </div>

  <div class="mx-auto mt-10 grid max-w-5xl gap-4 md:grid-cols-2">
    <!-- macOS -->
    <div
      class="group rounded-3xl border border-white/10 bg-white/[0.025] p-7 transition duration-300 hover:-translate-y-1 hover:border-pink-400/30 hover:bg-white/[0.04]"
    >
      <div
        class="flex h-12 w-12 items-center justify-center rounded-2xl border border-pink-400/20 bg-pink-400/10 text-xl text-pink-300"
      >
        
      </div>

      <h4 class="mt-6 text-xl font-semibold text-white">macOS</h4>

      <p class="mt-2 text-sm leading-6 text-white/45">
        Native binaries for both modern Apple Silicon Macs and Intel-based Macs.
      </p>

      <div class="mt-6 flex flex-wrap gap-2">
        <span
          class="rounded-full border border-pink-400/15 bg-pink-400/5 px-3 py-1 font-mono text-xs text-pink-200/80"
        >
          aarch64-apple-darwin
        </span>

        <span
          class="rounded-full border border-pink-400/15 bg-pink-400/5 px-3 py-1 font-mono text-xs text-pink-200/80"
        >
          x86_64-apple-darwin
        </span>
      </div>
    </div>

    <!-- Linux -->
    <div
      class="group rounded-3xl border border-white/10 bg-white/[0.025] p-7 transition duration-300 hover:-translate-y-1 hover:border-purple-400/30 hover:bg-white/[0.04]"
    >
      <div
        class="flex h-12 w-12 items-center justify-center rounded-2xl border border-purple-400/20 bg-purple-400/10 text-xl text-purple-300"
      >
        ◉
      </div>

      <h4 class="mt-6 text-xl font-semibold text-white">Linux</h4>

      <p class="mt-2 text-sm leading-6 text-white/45">
        Prebuilt binaries for standard 64-bit Linux systems and ARM64 devices.
      </p>

      <div class="mt-6 flex flex-wrap gap-2">
        <span
          class="rounded-full border border-purple-400/15 bg-purple-400/5 px-3 py-1 font-mono text-xs text-purple-200/80"
        >
          x86_64-unknown-linux-gnu
        </span>

        <span
          class="rounded-full border border-purple-400/15 bg-purple-400/5 px-3 py-1 font-mono text-xs text-purple-200/80"
        >
          aarch64-unknown-linux-gnu
        </span>
      </div>
    </div>
  </div>
</div>
