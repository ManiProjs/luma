---
const modules = [
  {
    title: "Tools",
    description: "Filesystem and shell capabilities",
    items: [
      "list_directory",
      "read_file",
      "search_files",
      "write_file",
      "patch_file",
      "run_command",
    ],
  },
  {
    title: "Context",
    description: "Conversation and workspace context",
    items: ["Messages", "Observations", "Project context"],
  },
  {
    title: "Workspace",
    description: "Project discovery and memory",
    items: ["Project detection", "Language detection", "GALAXY.md"],
  },
  {
    title: "Events",
    description: "Streaming agent activity",
    items: ["Text streaming", "Tool activity", "Planning", "Completion"],
  },
];
---

<section id="architecture" class="relative overflow-hidden py-32 sm:py-40">
  <!-- Background -->
  <div class="pointer-events-none absolute inset-0">
    <div
      class="absolute left-[10%] top-[15%] h-[500px] w-[500px] rounded-full bg-pink-500/5 blur-[140px]"
    >
    </div>

    <div
      class="absolute bottom-[10%] right-[5%] h-[600px] w-[600px] rounded-full bg-purple-500/5 blur-[160px]"
    >
    </div>
  </div>

  <div class="relative mx-auto max-w-7xl px-6 lg:px-8">
    <!-- Heading -->
    <div class="mx-auto max-w-3xl text-center">
      <p
        class="mb-5 text-sm font-medium uppercase tracking-[0.22em] text-fuchsia-300"
      >
        Under the hood
      </p>

      <h2
        class="text-4xl font-semibold tracking-tight text-white sm:text-5xl lg:text-6xl"
      >
        Built as a system,
        <span
          class="bg-gradient-to-r from-pink-400 via-fuchsia-400 to-purple-400 bg-clip-text text-transparent"
        >
          not a giant prompt.
        </span>
      </h2>

      <p class="mt-6 text-lg leading-8 text-white/55">
        Luma separates model interaction, planning, tools, context, and the user
        interface into focused components.
      </p>
    </div>

    <!-- Architecture diagram -->
    <div
      class="relative mx-auto mt-20 max-w-6xl rounded-[2rem] border border-white/10 bg-white/[0.025] p-6 sm:p-10 lg:p-14"
    >
      <!-- Top: Model -->
      <div class="flex flex-col items-center">
        <div
          class="w-full max-w-md rounded-2xl border border-pink-400/25 bg-gradient-to-br from-pink-400/10 to-fuchsia-500/5 p-6 text-center shadow-[0_0_60px_rgba(236,72,153,0.08)]"
        >
          <div class="text-sm font-medium text-pink-300">MODEL</div>

          <div class="mt-2 text-2xl font-semibold text-white">
            LLM abstraction
          </div>

          <p class="mt-2 text-sm text-white/45">
            OpenAI-compatible model endpoints
          </p>
        </div>

        <!-- Arrow -->
        <div
          class="my-5 h-10 w-px bg-gradient-to-b from-pink-400 to-fuchsia-400"
        >
        </div>

        <!-- Planner -->
        <div
          class="w-full max-w-md rounded-2xl border border-fuchsia-400/25 bg-fuchsia-400/5 p-6 text-center"
        >
          <div class="text-sm font-medium text-fuchsia-300">PLANNER</div>

          <div class="mt-2 text-2xl font-semibold text-white">
            Decide the next action
          </div>

          <p class="mt-2 text-sm text-white/45">
            Plan → act → observe → repeat
          </p>
        </div>

        <!-- Arrow -->
        <div
          class="my-5 h-10 w-px bg-gradient-to-b from-fuchsia-400 to-purple-400"
        >
        </div>

        <!-- Agent -->
        <div
          class="w-full max-w-xl rounded-3xl border border-purple-400/30 bg-gradient-to-br from-purple-400/10 to-pink-500/5 p-8 text-center shadow-[0_0_80px_rgba(168,85,247,0.08)]"
        >
          <div class="text-sm font-medium text-purple-300">AGENT</div>

          <div class="mt-2 text-3xl font-semibold tracking-tight text-white">
            Luma execution loop
          </div>

          <p class="mx-auto mt-3 max-w-md text-sm leading-6 text-white/50">
            Coordinates planning, tool execution, observations, and streaming
            events.
          </p>
        </div>
      </div>

      <!-- Connections -->
      <div
        class="my-10 h-px bg-gradient-to-r from-transparent via-fuchsia-400/50 to-transparent"
      >
      </div>

      <!-- Core modules -->
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
        {
          modules.map((module, index) => (
            <article class="group rounded-2xl border border-white/10 bg-black/20 p-5 transition duration-300 hover:-translate-y-1 hover:border-fuchsia-400/30 hover:bg-white/[0.04]">
              <div class="mb-4 flex items-center gap-3">
                <span
                  class:list={[
                    "flex h-8 w-8 items-center justify-center rounded-lg text-xs font-bold",
                    index === 0 &&
                      "bg-pink-400/10 text-pink-300 border border-pink-400/20",
                    index === 1 &&
                      "bg-fuchsia-400/10 text-fuchsia-300 border border-fuchsia-400/20",
                    index === 2 &&
                      "bg-purple-400/10 text-purple-300 border border-purple-400/20",
                    index === 3 &&
                      "bg-violet-400/10 text-violet-300 border border-violet-400/20",
                  ]}
                >
                  {String(index + 1).padStart(2, "0")}
                </span>

                <h3 class="font-semibold text-white">{module.title}</h3>
              </div>

              <p class="text-sm leading-6 text-white/40">
                {module.description}
              </p>

              <div class="mt-5 space-y-2 border-t border-white/5 pt-4">
                {module.items.map((item) => (
                  <div class="font-mono text-xs text-white/50">
                    <span class="mr-2 text-fuchsia-400">›</span>
                    {item}
                  </div>
                ))}
              </div>
            </article>
          ))
        }
      </div>
    </div>

    <!-- File structure -->
    <div class="mx-auto mt-16 max-w-5xl">
      <div class="mb-8 text-center">
        <p
          class="text-sm font-medium uppercase tracking-[0.2em] text-purple-300"
        >
          Project structure
        </p>

        <h3 class="mt-3 text-2xl font-semibold text-white">
          Modular by design.
        </h3>
      </div>

      <div
        class="overflow-hidden rounded-2xl border border-white/10 bg-black/40"
      >
        <div class="border-b border-white/10 px-5 py-3">
          <span class="font-mono text-xs text-white/40"> luma/ </span>
        </div>

        <pre
          class="overflow-x-auto p-6 font-mono text-xs leading-7 text-white/55 sm:text-sm"><code><span class="text-pink-300">src/</span>
├── <span class="text-fuchsia-300">agent/</span>       <span class="text-white/30"># Execution loop</span>
├── <span class="text-fuchsia-300">planner/</span>     <span class="text-white/30"># Decision making</span>
├── <span class="text-purple-300">model/</span>       <span class="text-white/30"># LLM abstraction</span>
├── <span class="text-pink-300">tools/</span>       <span class="text-white/30"># Workspace capabilities</span>
│   ├── filesystem/
│   └── shell/
├── <span class="text-fuchsia-300">context/</span>     <span class="text-white/30"># Agent context</span>
├── <span class="text-purple-300">history/</span>     <span class="text-white/30"># Conversation history</span>
├── <span class="text-pink-300">workspace/</span>   <span class="text-white/30"># Project understanding</span>
├── <span class="text-fuchsia-300">event/</span>       <span class="text-white/30"># Agent events</span>
└── <span class="text-purple-300">tui/</span>         <span class="text-white/30"># Terminal interface</span></code></pre>
      </div>
    </div>

    <!-- Bottom statement -->
    <div class="mx-auto mt-16 max-w-2xl text-center">
      <p class="text-lg leading-8 text-white/50">
        Each part of Luma has a focused responsibility, making the agent easier
        to extend as new tools, models, and capabilities are added.
      </p>
    </div>
  </div>
</section>
