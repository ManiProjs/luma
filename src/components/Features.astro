---
const features = [
  {
    icon: "tool",
    title: "Tool‑powered agent",
    description:
      "Inspects files, searches code, modifies your workspace, and runs commands instead of generating text only.",
    highlight: true,
  },
  {
    icon: "local",
    title: "Local‑first architecture",
    description:
      "Runs on your machine or private infrastructure with local and OpenAI‑compatible model endpoints.",
  },
  {
    icon: "developer",
    title: "Developer workflow",
    description:
      "Explores codebases, understands project context, edits files, and automates development tasks.",
  },
  {
    icon: "loop",
    title: "Agent loop",
    description:
      "Plans, uses tools, observes results, and continues until the task is complete with verification.",
  },
  {
    icon: "stream",
    title: "Streaming activity",
    description:
      "See responses, tool usage, and agent reasoning as work happens in real‑time.",
  },
  {
    icon: "memory",
    title: "Workspace memory",
    description:
      "Maintains project‑level context through project files to stay grounded in your codebase.",
  },
];

const getIcon = (iconName) => {
  const icons = {
    tool: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>`,
    local: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m2 7 10 10 10-10"></path><path d="M2 17l10-10 10 10"></path></svg>`,
    developer: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>`,
    loop: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"></path></svg>`,
    stream: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg>`,
    memory: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 18v-6a9 9 0 0 1 18 0v6"></path><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"></path></svg>`,
  };
  return icons[iconName] || icons.tool;
};
---

<section class="features-section">
  <div class="features-container">
    <div class="features-header">
      <h2 class="features-title">
        More than a chatbot.
        <span class="features-title-highlight">A coding agent.</span>
      </h2>
      <p class="features-description">
        Designed to work inside your developer workflow — understanding your project,
        using tools, and taking action when text alone isn't enough.
      </p>
    </div>

    <div class="features-grid">
      {features.map((feature, index) => (
        <div class:list={[
          "feature-card",
          feature.highlight && "feature-card-highlight"
        ]} key={index}>
          <div class="feature-icon" set:html={getIcon(feature.icon)}></div>
          <h3 class="feature-title">{feature.title}</h3>
          <p class="feature-description">{feature.description}</p>

          {feature.highlight && (
            <div class="feature-tags">
              <span class="feature-tag">Filesystem</span>
              <span class="feature-tag">Shell</span>
              <span class="feature-tag">Search</span>
              <span class="feature-tag">Code editing</span>
            </div>
          )}
        </div>
      ))}
    </div>

    <div class="features-footer">
      <p class="features-footer-text">
        Small models become significantly more useful when they can
        <span class="features-footer-emphasis">
          observe the real workspace, use tools, and verify their work.
        </span>
      </p>
    </div>
  </div>
</section>

<style>
  .features-section {
    padding: 6rem 1.5rem;
    background: var(--background);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .features-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .features-header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 4rem;
  }

  .features-title {
    margin: 0;
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--foreground);
  }

  .features-title-highlight {
    display: block;
    margin-top: 0.25em;
    color: var(--accent-primary);
  }

  .features-description {
    margin: 1.5rem auto 0;
    max-width: 600px;
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
    margin-bottom: 4rem;
  }

  .feature-card {
    padding: 2rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 1rem;
    background: var(--surface-elevated);
    transition: all 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .feature-card:hover {
    border-color: rgba(16, 185, 129, 0.3);
    background: var(--surface-hover);
    transform: translateY(-4px);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.3);
  }

  .feature-card-highlight {
    grid-column: span 2;
  }

  .feature-icon {
    width: 3rem;
    height: 3rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
    border-radius: 0.75rem;
    background: rgba(16, 185, 129, 0.1);
    color: var(--accent-primary);
  }

  .feature-icon svg {
    width: 1.5rem;
    height: 1.5rem;
  }

  .feature-title {
    margin: 0 0 0.75rem;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--foreground);
  }

  .feature-description {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .feature-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .feature-tag {
    padding: 0.375rem 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    background: var(--surface-hover);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--muted);
  }

  .features-footer {
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
  }

  .features-footer-text {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .features-footer-emphasis {
    color: var(--foreground);
    font-weight: 500;
  }

  /* Responsive design */
  @media (max-width: 1024px) {
    .feature-card-highlight {
      grid-column: span 1;
    }
  }

  @media (max-width: 768px) {
    .features-section {
      padding: 4rem 1.5rem;
    }

    .features-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .feature-card {
      padding: 1.5rem;
    }

    .features-description,
    .features-footer-text {
      font-size: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .feature-card:hover {
      transform: none;
    }
  }
</style>