---
const repoUrl = "https://github.com/ManiProjs/luma";
const releasesUrl = "https://github.com/ManiProjs/luma/releases";

const navigation = [
  { label: "Features", href: "#features" },
  { label: "How it works", href: "#how-it-works" },
  { label: "Tools", href: "#tools" },
  { label: "Architecture", href: "#architecture" },
];

const resources = [
  { label: "GitHub", href: repoUrl, external: true },
  { label: "Releases", href: releasesUrl, external: true },
];
---

<footer class="footer">
  <div class="footer-container">
    <div class="footer-grid">
      <!-- Brand -->
      <div class="footer-brand">
        <a href="#top" class="footer-logo">
          <div class="footer-logo-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12a9 9 0 1 1-6.219-8.56"></path>
              <path d="M21 12h-4l-3 9L9 3l-3 9H2"></path>
            </svg>
          </div>
          <span class="footer-logo-text">Luma</span>
        </a>

        <p class="footer-description">
          A lightweight AI coding agent built in Rust for local models,
          tool use, and practical developer workflows.
        </p>

        <p class="footer-built">
          Built with Rust. Built for developers.
        </p>
      </div>

      <!-- Navigation -->
      <div class="footer-section">
        <h3 class="footer-section-title">Explore</h3>
        <ul class="footer-links">
          {navigation.map((item) => (
            <li class="footer-link-item">
              <a href={item.href} class="footer-link">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Resources -->
      <div class="footer-section">
        <h3 class="footer-section-title">Resources</h3>
        <ul class="footer-links">
          {resources.map((item) => (
            <li class="footer-link-item">
              <a
                href={item.href}
                class="footer-link"
                target={item.external ? "_blank" : undefined}
                rel={item.external ? "noopener noreferrer" : undefined}
              >
                {item.label}
                {item.external && (
                  <span class="footer-link-icon" aria-hidden="true">↗</span>
                )}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom -->
    <div class="footer-bottom">
      <p class="footer-copyright">
        © {new Date().getFullYear()} Luma. Released under the MIT License.
      </p>
      <a
        href={repoUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="footer-repo"
      >
        github.com/ManiProjs/luma
      </a>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    background: var(--background);
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 4rem 1.5rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  .footer-brand {
    max-width: 400px;
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--foreground);
    margin-bottom: 1rem;
  }

  .footer-logo:hover {
    opacity: 0.8;
  }

  .footer-logo-icon {
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.5rem;
    border: 1px solid rgba(16, 185, 129, 0.2);
    background: rgba(16, 185, 129, 0.1);
    color: var(--accent-primary);
  }

  .footer-logo-icon svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .footer-description {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .footer-built {
    margin: 1rem 0 0;
    font-size: 0.875rem;
    color: var(--muted);
  }

  .footer-section {
    max-width: 200px;
  }

  .footer-section-title {
    margin: 0 0 1rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .footer-links {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-link-item {
    margin-bottom: 0.5rem;
  }

  .footer-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.875rem;
    color: var(--muted);
    text-decoration: none;
    transition: color 200ms ease;
  }

  .footer-link:hover {
    color: var(--foreground);
  }

  .footer-link-icon {
    font-size: 0.75rem;
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 0.875rem;
    color: var(--muted);
  }

  .footer-copyright {
    margin: 0;
  }

  .footer-repo {
    color: var(--accent-primary);
    text-decoration: none;
    transition: opacity 200ms ease;
  }

  .footer-repo:hover {
    opacity: 0.8;
  }

  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 4rem;
    }

    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }
</style>