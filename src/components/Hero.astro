---
interface Props {
  terminalDemo?: boolean;
}
const { terminalDemo = true } = Astro.props;
---

<section class="hero-section">
  <!-- Background grid - subtle, intentional -->
  <div class="hero-background" aria-hidden="true">
    <div class="hero-grid-pattern"></div>
    <div class="hero-accent-overlay"></div>
  </div>

  <div class="hero-container">
    <div class="hero-content">
      <!-- Minimal, intentional eyebrow - no dot -->
      <div class="hero-badge">
        <span class="hero-badge-icon">⌥</span>
        <span class="hero-badge-text">LOCAL-FIRST AI AGENT</span>
      </div>

      <h1 class="hero-headline">
        Codebase intelligence
        <span class="hero-headline-highlight">that works locally.</span>
      </h1>

      <p class="hero-description">
        Luma is a Rust-based AI coding agent that inspects your workspace, uses development tools,
        and verifies its work — all running on your local machine or private infrastructure.
      </p>

      <div class="hero-actions">
        <a href="#download" class="button button-primary">
          <span class="button-icon">↓</span>
          <span>Download for macOS</span>
        </a>
        <a
          href="https://github.com/ManiProjs/luma"
          class="button button-secondary"
          target="_blank"
          rel="noreferrer"
        >
          <span class="button-icon">⌘</span>
          <span>View source</span>
        </a>
      </div>

      <!-- Simple, clean stats - no icons, no boxes -->
      <div class="hero-stats">
        <div class="hero-stat">
          <div class="hero-stat-value">Native</div>
          <div class="hero-stat-label">Rust core</div>
        </div>
        <div class="hero-stat">
          <div class="hero-stat-value">Local</div>
          <div class="hero-stat-label">Model support</div>
        </div>
        <div class="hero-stat">
          <div class="hero-stat-value">Tool‑based</div>
          <div class="hero-stat-label">Agent actions</div>
        </div>
        <div class="hero-stat">
          <div class="hero-stat-value">TUI</div>
          <div class="hero-stat-label">Dev workflow</div>
        </div>
      </div>
    </div>

    <!-- Terminal preview - authentic, not overly stylized -->
    {terminalDemo && (
      <div class="terminal-preview">
        <div class="terminal-window">
          <div class="terminal-header">
            <div class="terminal-controls">
              <span class="terminal-control terminal-control-close"></span>
              <span class="terminal-control terminal-control-minimize"></span>
              <span class="terminal-control terminal-control-maximize"></span>
            </div>
            <div class="terminal-title">luma — ~/projects/my‑workspace</div>
          </div>
          <div class="terminal-body">
            <div class="terminal-line terminal-line-prompt">
              <span class="terminal-prompt-icon">❯</span>
              <span class="terminal-command">luma</span>
            </div>
            <div class="terminal-line">Initializing Luma...</div>
            <div class="terminal-line terminal-line-success">
              <span class="terminal-success-icon">✓</span>
              <span>Workspace detected</span>
            </div>
            <div class="terminal-line terminal-line-success">
              <span class="terminal-success-icon">✓</span>
              <span>Loaded project context</span>
            </div>
            <div class="terminal-line terminal-line-success">
              <span class="terminal-success-icon">✓</span>
              <span>Connected to local model</span>
            </div>
            <div class="terminal-line terminal-line-prompt">
              <span class="terminal-prompt-icon">❯</span>
              <span class="terminal-command">analyze borrow checker error</span>
            </div>
            <div class="terminal-line terminal-line-label">
              <span class="terminal-label">plan</span>
              <span>Analyzing workspace...</span>
            </div>
            <div class="terminal-line terminal-line-active">
              <span class="terminal-active-icon">↻</span>
              <span>Agent working...</span>
            </div>
          </div>
        </div>
        <div class="terminal-caption">
          <div class="terminal-status">
            <span class="terminal-status-indicator"></span>
            <span class="terminal-status-text">Agent session</span>
          </div>
          <p class="terminal-description">
            Luma explores your workspace, selects tools based on context, observes results,
            and continues until the task is complete.
          </p>
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    min-height: 100vh;
    overflow: hidden;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    background: var(--background);
  }

  .hero-background {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .hero-grid-pattern {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(circle at 50% 50%, black 30%, transparent 70%);
  }

  .hero-accent-overlay {
    position: absolute;
    top: -40%;
    left: -20%;
    width: 140%;
    height: 140%;
    background: radial-gradient(
      circle at 50% 50%,
      rgba(16, 185, 129, 0.03) 0%,
      transparent 60%
    );
  }

  .hero-container {
    width: min(100%, 1200px);
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .hero-content {
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
    padding: 4rem 0 6rem;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    margin-bottom: 2rem;
    border: 1px solid rgba(16, 185, 129, 0.3);
    border-radius: 999px;
    background: rgba(16, 185, 129, 0.05);
    color: var(--accent-primary);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .hero-badge-icon {
    font-size: 1rem;
  }

  .hero-headline {
    margin: 0;
    font-size: clamp(3rem, 7vw, 5rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--foreground);
  }

  .hero-headline-highlight {
    display: block;
    margin-top: 0.25em;
    color: var(--accent-primary);
  }

  .hero-description {
    max-width: 600px;
    margin: 1.5rem auto 0;
    font-size: clamp(1rem, 1.75vw, 1.25rem);
    line-height: 1.6;
    color: var(--muted);
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.5rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.75rem;
    border-radius: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 200ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .button-primary {
    background: var(--accent-primary);
    color: white;
    box-shadow: 0 4px 16px rgba(16, 185, 129, 0.25);
  }

  .button-primary:hover {
    background: #0da271;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(16, 185, 129, 0.35);
  }

  .button-primary:active {
    transform: translateY(0);
  }

  .button-secondary {
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: var(--surface-elevated);
    color: var(--foreground);
  }

  .button-secondary:hover {
    background: var(--surface-hover);
    border-color: rgba(255, 255, 255, 0.2);
    transform: translateY(-2px);
  }

  .button-icon {
    font-size: 1.125rem;
  }

  .hero-stats {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 2.5rem;
    margin-top: 4rem;
    padding-top: 2.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .hero-stat {
    text-align: center;
  }

  .hero-stat-value {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--foreground);
  }

  .hero-stat-label {
    margin-top: 0.25rem;
    font-size: 0.875rem;
    color: var(--muted);
  }

  /* Terminal preview styles */
  .terminal-preview {
    margin-top: 4rem;
    max-width: 900px;
    margin-left: auto;
    margin-right: auto;
  }

  .terminal-window {
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0.75rem;
    background: rgba(0, 0, 0, 0.5);
    overflow: hidden;
    box-shadow: 0 32px 64px rgba(0, 0, 0, 0.5);
  }

  .terminal-header {
    display: flex;
    align-items: center;
    padding: 0.75rem 1rem;
    background: rgba(255, 255, 255, 0.03);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .terminal-controls {
    display: flex;
    gap: 0.5rem;
  }

  .terminal-control {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
  }

  .terminal-control-close {
    background: #ef4444;
  }

  .terminal-control-minimize {
    background: #f59e0b;
  }

  .terminal-control-maximize {
    background: #10b981;
  }

  .terminal-title {
    flex: 1;
    text-align: center;
    font-family: ui-monospace, monospace;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .terminal-body {
    padding: 1.5rem;
    font-family: ui-monospace, monospace;
    font-size: 0.875rem;
    line-height: 1.7;
  }

  .terminal-line {
    margin: 0.5rem 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .terminal-line-prompt {
    color: var(--foreground);
  }

  .terminal-prompt-icon {
    color: var(--accent-primary);
    margin-right: 0.5rem;
  }

  .terminal-command {
    color: var(--foreground);
    font-weight: 500;
  }

  .terminal-line-success {
    color: var(--success);
  }

  .terminal-success-icon {
    margin-right: 0.5rem;
  }

  .terminal-line-label {
    color: var(--muted);
  }

  .terminal-label {
    display: inline-block;
    padding: 0.125rem 0.5rem;
    margin-right: 0.5rem;
    border-radius: 0.25rem;
    background: rgba(59, 130, 246, 0.1);
    color: var(--accent-secondary);
    font-size: 0.75rem;
    font-weight: 500;
  }

  .terminal-line-active {
    color: var(--accent-primary);
  }

  .terminal-active-icon {
    margin-right: 0.5rem;
    animation: pulse 2s infinite;
  }

  .terminal-caption {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem;
    margin-top: 1.5rem;
  }

  .terminal-status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .terminal-status-indicator {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--success);
    animation: pulse 2s infinite;
  }

  .terminal-status-text {
    font-size: 0.875rem;
    color: var(--muted);
  }

  .terminal-description {
    flex: 1;
    margin: 0;
    max-width: 500px;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--muted);
  }

  @keyframes pulse {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
  }

  /* Responsive design */
  @media (max-width: 768px) {
    .hero-content {
      padding: 2rem 0 4rem;
    }

    .hero-headline {
      font-size: clamp(2.5rem, 8vw, 3.5rem);
    }

    .hero-actions {
      flex-direction: column;
      align-items: center;
    }

    .hero-actions .button {
      width: 100%;
      max-width: 280px;
    }

    .hero-stats {
      gap: 1.5rem;
    }

    .hero-stat-value {
      font-size: 1.5rem;
    }

    .terminal-preview {
      margin-top: 3rem;
    }

    .terminal-caption {
      flex-direction: column;
      gap: 0.75rem;
    }

    .terminal-body {
      padding: 1rem;
      font-size: 0.8125rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .button-primary:hover,
    .button-secondary:hover {
      transform: none;
    }

    .terminal-active-icon,
    .terminal-status-indicator {
      animation: none;
    }
  }
</style>