<script>
  const section = document.getElementById("terminal-section")!;
  const terminal = document.getElementById("terminal-frame")!;
  function updateTerminal() {
    const rect = section.getBoundingClientRect();
    const scrollDistance = section.offsetHeight + window.innerHeight;
    const traveled = window.innerHeight - rect.top;
    const progress = Math.max(0, Math.min(1, traveled / scrollDistance));
    const translateY = 180 - progress * 180;
    const scale = 0.78 + progress * 0.22;
    const rotateX = 14 - progress * 14;
    terminal.style.transform = `
perspective(1800px) translateY(${translateY}px) rotateX(${rotateX}deg) scale(${
      scale
    }) `;
  }
  let ticking = false;
  function onScroll() {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      updateTerminal();
      ticking = false;
    });
  }
  window.addEventListener("scroll", onScroll, { passive: true });
  window.addEventListener("resize", updateTerminal);
  updateTerminal();
</script>
